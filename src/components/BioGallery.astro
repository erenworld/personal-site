---
import fs from 'node:fs'
import path from 'node:path'

// Staggered two-up photo pair, same layout as leerob.com's bio galleries.
// Items whose file is missing from /public are skipped, so a gallery with no
// photos yet renders nothing instead of broken images.
interface Item {
  src: string
  alt: string
  width?: number
  height?: number
}

interface Props {
  items: Item[]
}

const { items } = Astro.props
const existing = items.filter((item) => fs.existsSync(path.join('public', item.src)))
const spans = ['col-span-7', 'col-span-5 mt-8 sm:mt-12']
---

{
  existing.length > 0 && (
    <div class='bio-gallery'>
      <div class='grid grid-cols-12 items-start gap-3 sm:gap-4'>
        {existing.map((item, i) => (
          <button
            type='button'
            class={`bio-gallery-item ${existing.length === 1 ? 'col-span-12' : spans[i % 2]}`}
            aria-label={`Open image: ${item.alt}`}
            data-lightbox-src={item.src}
            data-lightbox-caption={item.alt}
          >
            <img
              alt=''
              loading='lazy'
              decoding='async'
              width={item.width}
              height={item.height}
              class='block h-auto w-full'
              src={item.src}
            />
          </button>
        ))}
      </div>
    </div>
  )
}
