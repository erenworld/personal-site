---
// Default / Long bio switcher. Both bios are rendered; the script swaps which one is visible.
---

<section class='bio-section' aria-label='Biography'>
  <div class='bio-toggle'>
    <span>Bio</span>
    <div class='bio-toggle-options' aria-label='Bio length'>
      <button type='button' aria-controls='bio-content' aria-pressed='true' data-bio='default'>
        Default
      </button>
      <button type='button' aria-controls='bio-content' aria-pressed='false' data-bio='long'>
        Long
      </button>
    </div>
  </div>
  <div id='bio-content'>
    <div data-bio-panel='default'>
      <slot name='default' />
    </div>
    <div class='long-bio' data-bio-panel='long' hidden>
      <slot name='long' />
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.bio-toggle button[data-bio]')
  const panels = document.querySelectorAll<HTMLElement>('[data-bio-panel]')

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.dataset.bio
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)))
      panels.forEach((p) => (p.hidden = p.dataset.bioPanel !== target))
    })
  })
</script>
