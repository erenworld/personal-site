---
const { href, ...props } = Astro.props
const isInternal = typeof href === 'string' && (href.startsWith('/') || href.startsWith('#'))
---

{
  isInternal ? (
    <a class='content-link' href={href} {...props}>
      <slot />
    </a>
  ) : (
    <a class='content-link' href={href} target='_blank' rel='noopener noreferrer' {...props}>
      <slot />
    </a>
  )
}
