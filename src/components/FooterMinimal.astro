---
import { gitInfo, REPO_URL } from "@/utils/git";

const path = Astro.url.pathname.replace(/\/$/, "");
const file = `~${path || "/"}`;
const commitUrl = gitInfo.sha ? `${REPO_URL}/commit/${gitInfo.sha}` : REPO_URL;
---

<footer class="statusline mt-2lh flex h-lh items-stretch justify-between whitespace-nowrap">
  <div class="flex min-w-0 items-stretch">
    <span class="seg seg-branch">
      <span class="i-pixel-branch" aria-hidden="true"></span>
      {gitInfo.branch}
    </span>
    <span class="text-fg-1 flex min-w-0 items-center px-1">
      <span class="truncate">{file}</span>
    </span>
  </div>

  <div class="flex shrink-0 items-stretch">
    {
      gitInfo.shortSha && (
        <a
          href={commitUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="seg-r seg-commit"
          title="Last commit"
        >
          ~{gitInfo.shortSha}
        </a>
      )
    }
    <a
      href={REPO_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="seg-r seg-source font-bold"
      title="Source code"
    >
      <span class="i-pixel-code" aria-hidden="true"></span>
      source
    </a>
  </div>
</footer>

<style>
  .seg,
  .seg-r {
    display: flex;
    align-items: center;
    gap: 1ch;
    padding-inline: 1ch;
  }

  .seg-r:hover,
  .seg-r:focus-visible {
    color: var(--color-blue-0);
    text-decoration: underline;
    outline: none;
  }

  @media (max-width: 1023px) {
    .statusline {
      display: none;
    }
  }
</style>
