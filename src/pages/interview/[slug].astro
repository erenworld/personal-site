---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getPosts } from "../../utils/posts";
import ListTags from "../../components/ListTags.vue";

export const prerender = true;
export async function getStaticPaths() {
  const posts = await getPosts("interview");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props as any;

const allPosts = ((await getPosts("interview")) as any[]).filter((p) => !p.data.soon);
let next = undefined as any;
const postIndex = allPosts.findIndex((p) => p.id === post.id);
if (postIndex >= allPosts.length - 1 || postIndex < 0) {
  next = {
    collection: post.collection,
    slug: allPosts[0]?.id,
  };
} else {
  next = {
    collection: post.collection,
    slug: allPosts[postIndex + 1]?.id,
  };
}

const { title, description, date, tags, location, guestUrl } = post.data;
const { Content } = await render(post);

// Convert the formatted date back to ISO format for schema
const isoDate = new Date(post.data.date).toISOString();
---

<BaseLayout
  title={title}
  description={description}
  image={{
    src: `/interview/${post.id}/og.png`,
    alt: title,
  }}
  pageType="article"
  pageOperate={true}
  comments={true}
  tags={tags}
  next={next}
  articleSchema={{
    headline: title,
    datePublished: isoDate,
    description: description,
  }}
>
  <article class="mb-8 sm:mb-12">
    <header class="mb-8">
      <h1 class="text-title">
        {title}
      </h1>
      <div class="flex items-center gap-2 text-main text-gray-400 mt-4 flex-wrap">
        <div class="flex-none">{date}</div>
        {
          location && (
            <div class="flex gap-1 items-center">
              <div>·</div>
              <div class="flex-none">{location}</div>
            </div>
          )
        }
        {
          guestUrl && (
            <div class="flex gap-1 items-center">
              <div>·</div>
              <a href={guestUrl} class="prose-link flex-none" target="_blank" rel="noopener noreferrer">databasestory.com</a>
            </div>
          )
        }
        {
          tags?.length && (
            <div class="flex gap-1 items-center">
              <div>·</div>
              <ListTags tags={tags} />
            </div>
          )
        }
      </div>
    </header>
    <div class="max-w-none prose">
      <Content />
    </div>
  </article>
</BaseLayout>
